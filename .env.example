# =============================================================================
# MikroWizard+ Terminal Gateway — Environment Variables (.env)
# =============================================================================

# Gateway Listening Port & IP Bind (Default 127.0.0.1 for local security)
PORT=8200
GATEWAY_BIND=127.0.0.1
AGENT_BIND=127.0.0.1

# Bearer Token for Backend <-> Gateway Authentication
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
GATEWAY_TOKEN=

# Backend Redis connection (for session validation)
PYSRV_REDIS_HOST=127.0.0.1:6379

# Backend PostgreSQL Database
PYSRV_DATABASE_HOST=127.0.0.1
PYSRV_DATABASE_PORT=5432
PYSRV_DATABASE_NAME=MIKROMAN
PYSRV_DATABASE_USER=mikroman
PYSRV_DATABASE_PASSWORD=

# Encryption key from server-conf.json
PYSRV_CRYPT_KEY=

# Directory where terminal session recordings (.cast) are stored
PYSRV_TERMINAL_RECORDINGS_DIR=/opt/mikrowizard/terminal_recordings
